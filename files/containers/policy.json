{
	"default": [
		{
			"type": "reject"
		}
	],
	"transports": {
		"docker": {
			"docker.io": [
				{
					"type": "insecureAcceptAnything"
				}
			],
			"registry.fedoraproject.org": [
				{
					"type": "insecureAcceptAnything"
				}
			],
			"ghcr.io/vlados-it/fedora-laptop-niri": [
				{
					"type": "sigstoreSigned",
					"keyPath": "/etc/pki/containers/cosign.pub",
					"signedIdentity": {
						"type": "matchRepository"
					}
				}
			]
		},
		"containers-storage": {
			"": [
				{
					"type": "insecureAcceptAnything"
				}
			]
		}
	}
}