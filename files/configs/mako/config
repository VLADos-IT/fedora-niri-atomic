
layer=overlay
anchor=top-right
margin=16,16
border-radius=12
border-size=2
padding=12
text-color=#eceff4
background-color=#1e1e2e
border-color=#88c0d0

font=JetBrainsMono Nerd Font Mono 11

default-timeout=5000
width=380
height=120
max-history=100

icon-path=/usr/share/icons/Papirus:/usr/share/icons/Adwaita/48x48/status
max-icon-size=48
on-button-left=invoke-default-action
on-button-right=dismiss
on-touch=dismiss
group-by=app-name

[app-name="Telegram Desktop"]
default-timeout=0

[app-name="layout"]
anchor=center
border-color=#bf616a
width=250
height=100
default-timeout=100

[urgency=low]
border-color=#45475a
background-color=#1e1e2e
text-color=#a6adc8

[urgency=normal]
border-color=#f9e2af
background-color=#1e1e2e
text-color=#cdd6f4

[urgency=high]
default-timeout=0
border-color=#f38ba8
background-color=#1e1e2e
text-color=#ffffff
